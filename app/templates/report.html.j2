<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>マクドナルド日次レポート</title>
  <style>
    :root {
      --ink: #1a1a1a;
      --muted: #6b6b6b;
      --line: #e8ddd0;
      --brand: #DA291C;
      --brand-dark: #a81d13;
      --accent: #FFC72C;
      --cream: #fffbf5;
      --soft: #fff3cc;
      --card: #ffffff;
      --link: #1558aa;
      --active-bg: #fff3cd;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      color: var(--ink);
      background: var(--cream);
      font-family: "Yu Gothic", "YuGothic", "Meiryo", system-ui, sans-serif;
      line-height: 1.65;
    }

    /* ===== HEADER ===== */
    header {
      position: sticky;
      top: 0;
      z-index: 10;
      background: var(--brand);
      box-shadow: 0 3px 12px rgba(0,0,0,0.25);
    }
    header::before { display: none; }
    .header-inner {
      max-width: 1180px;
      margin: 0 auto;
      padding: 14px 28px 16px;
      display: flex;
      align-items: center;
      gap: 16px;
      flex-wrap: wrap;
    }
    /* Golden Arches logo (CSS) */
    .mc-logo {
      display: inline-flex;
      gap: 4px;
      align-items: flex-end;
      height: 44px;
      flex-shrink: 0;
    }
    .mc-arch {
      width: 20px;
      height: 40px;
      border: 8px solid var(--accent);
      border-bottom: none;
      border-radius: 50% 50% 0 0 / 60% 60% 0 0;
      box-sizing: border-box;
    }
    .header-text { flex: 1; min-width: 0; }
    h1 {
      margin: 0;
      color: var(--accent);
      font-size: 24px;
      font-weight: 900;
      letter-spacing: -0.01em;
      line-height: 1.2;
    }
    .date {
      margin-top: 3px;
      color: rgba(255,255,255,0.85);
      font-size: 12px;
      font-weight: 700;
    }
    .window {
      margin-top: 2px;
      color: rgba(255,255,255,0.7);
      font-size: 12px;
      font-weight: 700;
    }
    .date-picker {
      position: relative;
      display: inline-block;
      margin-top: 8px;
    }
    .date-trigger {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      min-height: 34px;
      padding: 7px 13px;
      border: 1.5px solid var(--accent);
      border-radius: 999px;
      color: var(--accent);
      background: rgba(255,255,255,0.08);
      font-size: 13px;
      font-weight: 700;
      white-space: nowrap;
      cursor: pointer;
    }
    .date-trigger:hover,
    .date-trigger[aria-expanded="true"] {
      background: var(--accent);
      color: var(--brand);
    }
    .date-menu {
      position: absolute;
      top: calc(100% + 6px);
      left: 0;
      z-index: 20;
      display: none;
      min-width: 180px;
      padding: 6px;
      border: 1px solid var(--line);
      border-radius: 12px;
      background: #fff;
      box-shadow: 0 10px 28px rgba(0,0,0,0.2);
    }
    .date-picker.open .date-menu {
      display: grid;
      gap: 4px;
    }
    .date-option {
      width: 100%;
      padding: 8px 10px;
      border: 0;
      border-radius: 8px;
      color: var(--ink);
      background: transparent;
      font-size: 13px;
      font-weight: 700;
      text-align: left;
      cursor: pointer;
    }
    .date-option:hover,
    .date-option.active {
      color: var(--brand);
      background: var(--active-bg);
    }

    /* ===== MAIN CONTENT ===== */
    main {
      max-width: 1180px;
      margin: 0 auto;
      padding: 20px 18px 52px;
    }
    .report-panel {
      display: none;
    }
    .report-panel.active {
      display: block;
    }
    h2 {
      display: flex;
      align-items: center;
      gap: 10px;
      margin: 32px 0 12px;
      padding: 10px 14px;
      border-radius: 10px;
      background: var(--brand);
      color: #fff;
      font-size: 17px;
      font-weight: 800;
    }
    h2::before { display: none; }
    .h2-icon {
      font-size: 20px;
      line-height: 1;
      flex-shrink: 0;
    }
    .section-count {
      margin-left: auto;
      color: rgba(255,255,255,0.75);
      font-size: 12px;
      font-weight: 700;
      background: rgba(0,0,0,0.15);
      padding: 2px 8px;
      border-radius: 999px;
    }
    a {
      color: var(--link);
      overflow-wrap: anywhere;
    }
    .list {
      display: grid;
      gap: 8px;
    }
    .news-row {
      display: grid;
      grid-template-columns: 150px 1fr;
      gap: 14px;
      padding: 14px 16px;
      border: 1px solid var(--line);
      border-left: 4px solid var(--accent);
      border-radius: 12px;
      background: var(--card);
      box-shadow: 0 2px 6px rgba(0,0,0,0.06);
    }
    .news-date {
      color: var(--brand);
      font-size: 13px;
      font-weight: 800;
      white-space: nowrap;
    }
    .title {
      margin: 0 0 5px;
      font-size: 16px;
      font-weight: 800;
      line-height: 1.45;
    }
    .summary {
      margin: 0 0 4px;
      color: #3a3a3a;
      font-size: 14px;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .digest {
      display: grid;
      gap: 8px;
      margin: 0 0 20px;
    }
    .digest-item {
      padding: 10px 12px;
      border: 1px solid var(--line);
      border-left: 5px solid var(--accent);
      border-radius: 12px;
      background: var(--soft);
      font-size: 13px;
      font-weight: 700;
    }
    .ai-summary {
      margin: 0 0 24px;
      padding: 16px 20px;
      border: 1px solid #f0d97a;
      border-left: 6px solid var(--accent);
      border-radius: 14px;
      background: linear-gradient(135deg, #fffdf0 0%, #fff8e1 100%);
      box-shadow: 0 2px 8px rgba(255,199,44,0.15);
    }
    .ai-summary-label {
      display: flex;
      align-items: center;
      gap: 6px;
      margin: 0 0 8px;
      color: var(--brand-dark);
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }
    .ai-summary-label::before {
      content: "";
      display: inline-block;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--accent);
    }
    .ai-summary-text {
      margin: 0;
      color: var(--ink);
      font-size: 14px;
      font-weight: 600;
      line-height: 1.8;
    }
    .reason {
      margin: 8px 0 0;
      color: var(--muted);
      font-size: 12px;
      font-weight: 700;
      line-height: 1.5;
    }
    .source {
      font-size: 12px;
      color: var(--muted);
      font-weight: 700;
    }
    .cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 14px;
    }
    .card {
      border: 1px solid var(--line);
      border-radius: 14px;
      overflow: hidden;
      background: var(--card);
      box-shadow: 0 2px 0 rgba(168, 29, 19, 0.05);
    }
    .card-link {
      display: block;
      color: inherit;
      text-decoration: none;
      transition: transform 120ms ease, box-shadow 120ms ease, border-color 120ms ease;
    }
    .card-link:hover {
      border-color: var(--brand);
      box-shadow: 0 4px 0 rgba(168, 29, 19, 0.10);
      transform: translateY(-1px);
    }
    .card-body {
      padding: 14px;
    }
    .thumb {
      width: 100%;
      aspect-ratio: 16 / 9;
      object-fit: cover;
      display: block;
      background: var(--soft);
    }
    .metrics {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin: 8px 0;
    }
    .metric {
      padding: 5px 8px;
      border: 1px solid var(--accent);
      border-radius: 999px;
      background: var(--soft);
      color: var(--brand);
      font-size: 12px;
      font-weight: 800;
      white-space: nowrap;
    }
    .refs {
      padding: 12px 12px 12px 30px;
      font-size: 13px;
      background: #fff;
      border: 1px solid var(--line);
      border-radius: 12px;
    }
    .empty {
      padding: 16px;
      border: 1px solid var(--line);
      border-radius: 12px;
      background: #fff;
      color: var(--muted);
      font-weight: 700;
    }
    .section-count {
      margin-left: auto;
      color: var(--muted);
      font-size: 12px;
      font-weight: 700;
    }
    .collapsible .extra-item {
      display: none;
    }
    .collapsible.expanded .extra-item {
      display: grid;
    }
    .competitor-company {
      margin-bottom: 18px;
    }
    .competitor-company-name {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      margin: 0 0 8px;
      padding: 5px 14px;
      border-radius: 999px;
      background: var(--accent);
      border: none;
      color: var(--brand);
      font-size: 12px;
      font-weight: 900;
    }
    .book-row {
      display: grid;
      grid-template-columns: 80px 1fr;
      gap: 14px;
      padding: 14px 16px;
      border: 1px solid var(--line);
      border-radius: 12px;
      background: var(--card);
      box-shadow: 0 2px 0 rgba(168,29,19,0.04);
    }
    .book-meta {
      color: var(--brand-dark);
      font-size: 12px;
      font-weight: 800;
      line-height: 1.6;
    }
    .book-author {
      color: var(--muted);
      font-size: 11px;
      font-weight: 700;
      margin-top: 3px;
    }
    .show-more {
      width: 100%;
      min-height: 38px;
      border: 1px solid var(--line);
      border-radius: 999px;
      background: #fff;
      color: var(--brand-dark);
      font-size: 13px;
      font-weight: 800;
      cursor: pointer;
    }
    .show-more:hover {
      border-color: var(--brand);
      background: var(--active-bg);
    }
    .title-link {
      color: var(--ink);
      text-decoration: none;
    }
    .title-link:hover {
      color: var(--brand);
      text-decoration: underline;
      text-underline-offset: 3px;
    }
    @media (max-width: 680px) {
      header { padding: 0 16px 12px; }
      header::before { margin: 0 -16px 14px; }
      main { padding: 14px 14px 36px; }
      h1 { font-size: 21px; }
      .news-row {
        grid-template-columns: 1fr;
        gap: 4px;
      }
    }
  </style>
</head>
<body>
  <header>
    <div class="header-inner">
      <!-- McDonald's Golden Arches (CSS logo) -->
      <div class="mc-logo" aria-hidden="true">
        <div class="mc-arch"></div>
        <div class="mc-arch"></div>
      </div>
      <div class="header-text">
        <h1>マクドナルド日次レポート</h1>
        <div class="date" id="current-date">{{ default_date or "データなし" }}</div>
        <div class="window" id="current-window">
          {% if default_date and reports[default_date] %}対象期間: {{ reports[default_date].window }}{% endif %}
        </div>
        {% if report_dates %}
          <div class="date-picker" id="date-picker">
            <button class="date-trigger" id="date-trigger" type="button" aria-expanded="false" aria-haspopup="listbox">
              📅 <span id="selected-date-label">{{ default_date }}</span>
            </button>
            <div class="date-menu" role="listbox" aria-label="レポート日付">
              {% for report_date in report_dates %}
                <button class="date-option{% if report_date == default_date %} active{% endif %}" type="button" data-date="{{ report_date }}">{{ report_date }}</button>
              {% endfor %}
            </div>
          </div>
        {% endif %}
      </div>
    </div>
  </header>
  <main>
    {% if report_dates %}
      {% for report_date in report_dates %}
          {% set report = reports[report_date] %}
        <section class="report-panel{% if report_date == default_date %} active{% endif %}" data-panel="{{ report_date }}" data-window="{{ report.window }}">
          {% set grouped = report.grouped %}
          {% if report.daily_summary %}
            <div class="ai-summary">
              <div class="ai-summary-label">🤖 AI · 本日のマクドナルドサマリー</div>
              <p class="ai-summary-text">{{ report.daily_summary }}</p>
            </div>
          {% endif %}
          <h2><span class="h2-icon">☀️</span>今日のまとめ</h2>
          <section class="digest">
            {% for line in report.digest %}
              <div class="digest-item">{{ line }}</div>
            {% endfor %}
          </section>
          {% set sections = [
            ("youtube", "🎬", "YouTube注目動画", "youtube"),
            ("official", "🍔", "マクドナルド関連ニュース", "news"),
            ("sns", "📱", "X / Instagram / TikTokで伸びている話題", "sns")
          ] %}
          {% for key, icon, label, style in sections %}
            {% set items = grouped.get(key, []) %}
            <h2><span class="h2-icon">{{ icon }}</span>{{ label }}{% if items %}<span class="section-count">{{ items|length }}件</span>{% endif %}</h2>
            {% if items %}
              {% if style == "youtube" %}
                <section class="cards">
                  {% for item in items %}
                    {% include "partials/youtube_item.html.j2" %}
                  {% endfor %}
                </section>
              {% elif style == "sns" %}
                <section class="cards">
                  {% for item in items %}
                    {% include "partials/sns_item.html.j2" %}
                  {% endfor %}
                </section>
              {% else %}
                {% set collapsible = key == "official" and items|length > 3 %}
                <section class="list{% if collapsible %} collapsible{% endif %}" data-collapsible="{{ key }}-{{ report_date }}">
                  {% for item in items %}
                    {% if collapsible and loop.index > 3 %}<div class="extra-item">{% endif %}
                    {% include "partials/news_item.html.j2" %}
                    {% if collapsible and loop.index > 3 %}</div>{% endif %}
                  {% endfor %}
                  {% if collapsible %}
                    <button class="show-more" type="button" data-toggle="{{ key }}-{{ report_date }}">さらに表示</button>
                  {% endif %}
                </section>
              {% endif %}
            {% else %}
              <p class="empty">該当データはありません。</p>
            {% endif %}
          {% endfor %}

          {# ---- 競合・隣接業界の動き（企業別） ---- #}
          {% set ns = namespace(total=0) %}
          {% for _items in report.competitor_by_company.values() %}{% set ns.total = ns.total + _items|length %}{% endfor %}
          <h2><span class="h2-icon">🏁</span>競合・隣接業界の動き{% if ns.total > 0 %}<span class="section-count">{{ ns.total }}件</span>{% endif %}</h2>
          {% if report.competitor_summary %}
            <div class="digest" style="margin-bottom:16px">
              <div class="digest-item">{{ report.competitor_summary }}</div>
            </div>
          {% endif %}
          {% if report.competitor_by_company %}
            {% for company, comp_items in report.competitor_by_company.items() %}
              <div class="competitor-company">
                <div class="competitor-company-name">{{ company }}</div>
                <section class="list">
                  {% for item in comp_items %}
                    {% include "partials/news_item.html.j2" %}
                  {% endfor %}
                </section>
              </div>
            {% endfor %}
          {% else %}
            <p class="empty">本日は更新のある競合情報はありません。</p>
          {% endif %}

          {# ---- 書籍・出版情報 ---- #}
          <h2><span class="h2-icon">📚</span>書籍・出版情報{% if report.books %}<span class="section-count">{{ report.books|length }}件</span>{% endif %}</h2>
          {% if report.books %}
            <section class="list">
              {% for item in report.books %}
                {% include "partials/book_item.html.j2" %}
              {% endfor %}
            </section>
          {% else %}
            <p class="empty">該当する書籍データはありません。</p>
          {% endif %}

          <h2><span class="h2-icon">🔗</span>参照URL一覧</h2>
          <ol class="refs">
            {% for item in report.references %}
              <li><a href="{{ item.source_url }}">{{ item.title }}</a> / {{ item.source_name }}</li>
            {% endfor %}
          </ol>
        </section>
      {% endfor %}
    {% else %}
      <p class="empty">まだレポートデータがありません。collectを実行してください。</p>
    {% endif %}
  </main>
  <script>
    const tabs = document.querySelectorAll("[data-date]");
    const panels = document.querySelectorAll("[data-panel]");
    const currentDate = document.getElementById("current-date");
    const datePicker = document.getElementById("date-picker");
    const dateTrigger = document.getElementById("date-trigger");
    const selectedDateLabel = document.getElementById("selected-date-label");

    function activateReport(date) {
      tabs.forEach((tab) => tab.classList.toggle("active", tab.dataset.date === date));
      panels.forEach((panel) => panel.classList.toggle("active", panel.dataset.panel === date));
      if (currentDate) currentDate.textContent = date;
      if (selectedDateLabel) selectedDateLabel.textContent = date;
      if (datePicker) datePicker.classList.remove("open");
      if (dateTrigger) dateTrigger.setAttribute("aria-expanded", "false");
      const activePanel = document.querySelector(`[data-panel="${date}"]`);
      const currentWindow = document.getElementById("current-window");
      if (currentWindow && activePanel) currentWindow.textContent = `対象期間: ${activePanel.dataset.window}`;
      const url = new URL(window.location);
      url.hash = date;
      history.replaceState(null, "", url);
    }

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => activateReport(tab.dataset.date));
    });

    if (dateTrigger && datePicker) {
      dateTrigger.addEventListener("click", () => {
        const isOpen = datePicker.classList.toggle("open");
        dateTrigger.setAttribute("aria-expanded", String(isOpen));
      });
      document.addEventListener("click", (event) => {
        if (!datePicker.contains(event.target)) {
          datePicker.classList.remove("open");
          dateTrigger.setAttribute("aria-expanded", "false");
        }
      });
    }

    const initialDate = window.location.hash.replace("#", "");
    if (initialDate && document.querySelector(`[data-panel="${initialDate}"]`)) {
      activateReport(initialDate);
    }

    document.querySelectorAll("[data-toggle]").forEach((button) => {
      button.addEventListener("click", () => {
        const target = document.querySelector(`[data-collapsible="${button.dataset.toggle}"]`);
        if (!target) return;
        const expanded = target.classList.toggle("expanded");
        button.textContent = expanded ? "閉じる" : "さらに表示";
      });
    });
  </script>
</body>
</html>
