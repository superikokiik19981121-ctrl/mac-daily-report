<article class="news-row">
  <div class="news-date">{{ item.published_display }}</div>
  <div>
    <h3 class="title"><a class="title-link" href="{{ item.source_url }}" target="_blank" rel="noopener noreferrer">{{ item.title }}</a></h3>
    <p class="summary">{{ item.summary_display }}</p>
    <div class="source">{{ item.source_name }}</div>
  </div>
</article>
